// Sudoku Example with Partial Manual Inputs
// Only first two queens are manually assigned, rest are auto-solved
var Col1 in [1..4];
var Col2 in [1..4];
var Col3 in [1..4];
var Col4 in [1..4];

constraint Col1 != Col2;
constraint Col1 != Col3;
constraint Col1 != Col4;
constraint Col2 != Col3;
constraint Col2 != Col4;
constraint Col3 != Col4;


